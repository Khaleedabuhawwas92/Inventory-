{
  "name": "inventory-system-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "نظام إدارة المخزون - تطبيق سطح المكتب",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue.bold,green.bold \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "cd ../frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:frontend:electron": "cd ../frontend && npm run build -- --mode electron --outDir dist-electron",
    "build": "npm run build:frontend && npm run build:frontend:electron && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.inventorysystem.app",
    "productName": "نظام إدارة المخزون",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist-electron",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
